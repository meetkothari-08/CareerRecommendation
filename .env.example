# LLM endpoint (OpenAI-compatible). Leave LLM_API_KEY empty to use the offline template advisor.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# Fine-tuned model served locally with vLLM:
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=careerrec-advisor

# Optional: live job ingestion (scripts/ingest_jobs.py)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
